{
  "name": "ead-faculdade-ide-worker",
  "private": true,
  "type": "module",
  "description": "Worker do site EAD Faculdade IDE. O código da aplicação fica em ../lib e ../api.",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "npm run assets && cf dev",
    "deploy": "npm run assets && cf deploy",
    "db:migrate": "cf d1 migrations apply 3d550df8-e81a-4d82-b1af-ec2958a625ba",
    "db:import": "node scripts/import-from-backup.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "cf": "^0.15.0",
    "vite": "^8.3.6"
  }
}
