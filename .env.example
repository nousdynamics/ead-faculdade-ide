# Credenciais do painel CMS (obrigatório em produção)
CMS_USER=yeaslest
CMS_PASSWORD=lest1234567

# Segredo para assinar tokens JWT (gere um valor aleatório longo)
CMS_SECRET=

# E-mail inicial opcional da conta admin
CMS_EMAIL=

# Vercel Blob — store única conectada ao projeto (Storage → Blob → Connect)
# BLOB_STORE_ID aponta para store_i80YqqvfBoSS9Iv7 (gru1). OIDC no runtime Vercel.
# BLOB_READ_WRITE_TOKEN é opcional (gerado ao conectar Blob); runtime usa OIDC + BLOB_STORE_ID.
BLOB_STORE_ID=store_i80YqqvfBoSS9Iv7

# Sincronizar repo → Blob (requer `npx vercel login` + projeto linkado):
# npm run sync:blob
