# Credenciais do painel CMS
# CMS_SECRET é obrigatório em produção (auth fail-closed sem ele).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CMS_SECRET=
CMS_USER=
CMS_PASSWORD=
CMS_EMAIL=

# =============================================================================
# Storage — Supabase (recomendado após migração)
# =============================================================================
# Projeto: ead-faculdade-ide (sa-east-1)
# Dashboard: https://supabase.com/dashboard/project/sjokgfvaszczuisavuwb
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://sjokgfvaszczuisavuwb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_MEDIA_BUCKET=cms-media

# Personal Access Token (só para npm run configure:supabase-auth)
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Opcional — conexão direta Postgres (não usada pelo CMS hoje; supabase-js usa REST)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Tokens Blob (só para npm run migrate:blob-to-supabase)
# BLOB_STORE_ID=store_i80YqqvfBoSS9Iv7
# BLOB_MEDIA_STORE_ID=store_dCeVSERsUNiDaH6Z
# BLOB_READ_WRITE_TOKEN=
# BLOB_MEDIA_READ_WRITE_TOKEN=

# Scripts de migração:
# npm run sync:supabase              → data/cms → Supabase
# npm run migrate:blob-to-supabase   → Vercel Blob → Supabase
