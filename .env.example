# Credenciais do painel CMS (obrigatório em produção)
CMS_USER=yeaslest
CMS_PASSWORD=lest1234567

# Segredo para assinar tokens JWT (gere um valor aleatório longo)
CMS_SECRET=

# E-mail inicial opcional da conta admin
CMS_EMAIL=

# Vercel Blob — duas stores conectadas ao projeto (Storage → Blob → Connect)
# Privada (CMS, páginas HTML, conta): ead-faculdade-ide-blob → gru1
BLOB_STORE_ID=store_i80YqqvfBoSS9Iv7
# Pública (imagens/PDFs do CMS): ead-faculdade-ide-blob-public → gru1
BLOB_MEDIA_STORE_ID=store_dCeVSERsUNiDaH6Z
# Token RW da store pública (dashboard Vercel → Storage → blob-public → .env.local)
# BLOB_MEDIA_READ_WRITE_TOKEN=
# OIDC no runtime Vercel; token acima para migração/sync local (npm run migrate:blob-media).

# Sincronizar repo → Blob (requer `npx vercel login` + projeto linkado):
# npm run sync:blob
