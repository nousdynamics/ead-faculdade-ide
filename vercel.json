{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "ead-faculdade-ide",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/entrar",
      "destination": "/api/handler?path=auth-page/login"
    },
    {
      "source": "/cadastro",
      "destination": "/api/handler?path=auth-page/register"
    },
    {
      "source": "/minha-conta",
      "destination": "/api/handler?path=auth-page/account"
    },
    {
      "source": "/recuperar-senha",
      "destination": "/api/handler?path=auth-page/reset"
    },
    {
      "source": "/admin-usuarios",
      "destination": "/api/handler?path=auth-page/admin-users"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/handler?path=auth-page/callback"
    },
    {
      "source": "/redefinir-senha",
      "destination": "/api/handler?path=auth-page/new-password"
    },
    {
      "source": "/paginas-de-cursos",
      "destination": "/api/handler?path=catalog-page"
    },
    {
      "source": "/paginas-de-cursos/:filter",
      "destination": "/api/handler?path=catalog-page/:filter"
    },
    {
      "source": "/pos-graduacao/:slug",
      "destination": "/api/handler?path=course-page/:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/handler?path=$1"
    }
  ],
  "functions": {
    "api/handler.js": {
      "maxDuration": 10,
      "excludeFiles": "{.git/**,_capture/**,docs/**,assets/**,admin/**,scripts/**,pos-graduacao/**,node_modules/.cache/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/paginas-de-cursos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/paginas-de-cursos/:filter",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/pos-graduacao/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/minha-conta",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/entrar",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/cadastro",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/recuperar-senha",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
