{
  "name": "ead-faculdade-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Clone estático da EAD Faculdade IDE (HTML/CSS/JS)",
  "scripts": {
    "dev": "node scripts/cms-server.mjs",
    "dev:static": "npx --yes serve . -l 8080",
    "dev:vercel": "vercel dev",
    "cms": "node scripts/cms-server.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "generate:courses": "node scripts/generate-course-pages.mjs",
    "generate:all": "node scripts/generate-course-pages.mjs --all && node scripts/generate-sitemap.mjs",
    "sync:blob": "node scripts/sync-blob-storage.mjs",
    "sync:supabase": "node scripts/sync-supabase-cms.mjs",
    "migrate:blob-to-supabase": "node scripts/migrate-blob-to-supabase.mjs",
    "migrate:media-production": "node scripts/migrate-media-from-production.mjs",
    "migrate:account-supabase": "node scripts/migrate-account-to-supabase.mjs",
    "env:vercel-supabase": "node scripts/push-supabase-env-vercel.mjs",
    "migrate:blob-media": "node scripts/migrate-blob-media.mjs",
    "deploy:preview": "npx vercel",
    "deploy:prod": "npx vercel --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/blob": "^2.4.0"
  }
}
